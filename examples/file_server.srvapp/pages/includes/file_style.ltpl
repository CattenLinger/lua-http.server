<style>
    a { float: left; }
    a::before { width: 1em; float: left; content: "\0000a0"; padding: 0 3pt 0 0; }
    a.directory::before { content: "📁"; padding: 0 3pt 0 0; }
    table { width: 800px; }
    td { padding: 0 5px; white-space: nowrap; }
