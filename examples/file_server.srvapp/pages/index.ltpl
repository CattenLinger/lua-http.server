<!DOCTYPE html>
<html>
<head>
	<title>Index of <% path %></title>
	<meta charset="UTF-8">
	<%=include'index_style.ltpl'%>
</head>
<body>
<img src='https://github.com/LisovetsAlex/webindows/blob/main/backend/system/webindows/public/Assets/FileExplorer.png?raw=true'>
    <h1>Index of <% path %></h1>
    <table>
    <thead><tr>
        <th>File Name</th><th>Size</th><th>Modified</th>
    </tr></thead>
    <tbody>
<? for i, file in ipairs(files) do ?>
        <tr>
            <td class="filename"><a class='<% file.css_cls %>' href='<% file.href %>'
                ><% file.filename %></a></td>
            <td title='<% file.size %> bytes'><% file.size_h %></td>
            <td><time><% file.time %></time></td>
        </tr>
<? end ?>
    </tbody>
	</table>
</body>
</html>