<!DOCTYPE html>
<html>
<head>
	<title>Index of <% path %></title>
	<style>
		a { float: left; }
		a::before { width: 1em; float: left; content: "\0000a0"; padding: 0 3pt 0 0; }
		a.directory::before { content: "📁"; padding: 0 3pt 0 0; }
		table { width: 800px; }
		td { padding: 0 5px; white-space: nowrap; }
		td:nth-child(2) { text-align: right; width: 3em; }
		td:last-child { width: 1px; }
	</style>
</head>
<body>
    <h1>Index of <% path %></h1>
    <table>
    <thead><tr>
        <th>File Name</th><th>Size</th><th>Modified</th>
    </tr></thead>
    <tbody>
<? for i, file in ipairs(files) do ?>
        <tr>
            <td><a class='<% file.css_cls %>' href='<% file.href %>'
                ><% file.filename %></a></td>
            <td title='<% file.size %> bytes'><% file.size_h %></td>
            <td><time><% file.time %></time></td>
        </tr>
<? end ?>
    </tbody>
	</table>
</body>
</html>